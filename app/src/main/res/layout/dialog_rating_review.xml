<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ĐÁNH GIÁ &amp; NHẬN XÉT PHIM"
        android:textColor="#FFC107"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:id="@+id/tvMovieNameHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên phim"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"/>

    <!-- RATING SCORE INPUT -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chấm điểm (Thang điểm 10):"
        android:textColor="#AAAAAA"
        android:textSize="13sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:rating="4.0"
            android:progressTint="#FFC107"
            android:progressBackgroundTint="#555555"
            android:secondaryProgressTint="#FFC107"/>

        <TextView
            android:id="@+id/tvScoreDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="8.0 / 10"
            android:textColor="#FFC107"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <EditText
        android:id="@+id/edtScoreValue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext"
        android:hint="Hoặc nhập điểm từ 0.0 đến 10.0"
        android:textColorHint="#666666"
        android:textColor="#FFFFFF"
        android:inputType="numberDecimal"
        android:paddingHorizontal="14dp"
        android:textSize="14sp"/>

    <!-- REVIEW COMMENT INPUT -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Viết nhận xét của bạn:"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/edtReviewComment"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext"
        android:gravity="top|start"
        android:hint="Cảm nhận của bạn về bộ phim này (nội dung, diễn xuất, kỹ xảo...)"
        android:textColorHint="#666666"
        android:textColor="#FFFFFF"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textSize="14sp"/>

    <CheckBox
        android:id="@+id/cbMarkWatched"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Đánh dấu đã xem phim này"
        android:textColor="#FFFFFF"
        android:buttonTint="#FFC107"
        android:checked="true"/>

    <!-- BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnCancelRating"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="HỦY"
            android:textColor="#AAAAAA"
            android:backgroundTint="#333333"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSaveRating"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="LƯU ĐÁNH GIÁ"
            android:textColor="#121212"
            android:textStyle="bold"
            android:backgroundTint="#FFC107"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
