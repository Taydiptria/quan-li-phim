<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOVIEBOX"
                    android:textColor="#FFC107"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your personal movie collection"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnAddMovie"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_menu_add"
                    android:background="@drawable/bg_movie_item"
                    android:padding="10dp"
                    app:tint="#FFC107"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Thêm phim"/>

                <ImageView
                    android:id="@+id/btnStatistics"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:background="@drawable/bg_movie_item"
                    android:padding="10dp"
                    app:tint="#FFC107"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Thống kê"/>

                <ImageView
                    android:id="@+id/btnProfile"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:background="@drawable/bg_movie_item"
                    android:padding="10dp"
                    app:tint="#FFC107"
                    android:contentDescription="Cá nhân và Cài đặt"/>
            </LinearLayout>
        </LinearLayout>

        <!-- BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_banner"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WELCOME TO"
                android:textColor="#FFC107"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="YOUR MOVIE WORLD"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Quản lý, đánh giá &amp; thống kê bộ sưu tập phim"
                android:textColor="#CCCCCC"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- QUICK NAVIGATION ROW (3 BUTTONS: STATS, FAVORITES, WATCHED) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnQuickStats"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="📊 Thống kê"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#262626"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnQuickFavorites"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="♥ Yêu thích"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#262626"
                android:layout_marginHorizontal="4dp"/>

            <Button
                android:id="@+id/btnQuickWatched"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="✔ Đã xem"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#262626"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- PHIM YEU THICH -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Phim yêu thích"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvFavoriteEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa có phim yêu thích"
            android:textColor="#888888"
            android:padding="12dp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavoriteMovies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"/>

        <!-- PHIM MOI THEM -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Phim mới thêm"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="25dp"
            android:text="Chưa có phim nào. Hãy thêm phim mới!"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMovies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="MOVIEBOX • YOUR MOVIE COLLECTION"
            android:textColor="#555555"
            android:textSize="10sp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
