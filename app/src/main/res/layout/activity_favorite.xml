<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← QUAY LẠI"
            android:textColor="#FFC107"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="8dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DANH SÁCH PHIM YÊU THÍCH"
        android:textColor="#FFC107"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"/>

    <!-- SEARCH IN FAVORITES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edittext"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#FFC107"
            android:contentDescription="Search Icon"/>

        <EditText
            android:id="@+id/edtFavoriteSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@null"
            android:hint="Tìm trong danh sách yêu thích..."
            android:textColorHint="#777777"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:inputType="text"
            android:maxLines="1"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvFavoriteCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tổng số: 0 phim yêu thích"
        android:textColor="#888888"
        android:textSize="13sp"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="40dp"
        android:text="Bạn chưa thêm bộ phim nào vào danh sách yêu thích."
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavoriteMovies"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"/>
</LinearLayout>
