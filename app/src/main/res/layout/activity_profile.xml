<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← QUAY LẠI"
                android:textColor="@color/accent_gold"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HỒ SƠ &amp; CÀI ĐẶT"
            android:textColor="@color/accent_gold"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <!-- AVATAR & USER SUMMARY CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gold"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/imgProfileAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="@drawable/bg_movie_item"
                android:padding="12dp"
                app:tint="@color/accent_gold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Ảnh đại diện"/>

            <TextView
                android:id="@+id/btnChangeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Đổi ảnh đại diện"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:padding="4dp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvProfileDisplayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên người dùng"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/tvProfileDisplayEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="user@example.com"
                android:textColor="@color/text_sub"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- PROFILE EDIT FORM -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÔNG TIN CÁ NHÂN"
            android:textColor="@color/accent_gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Họ và tên:"
                android:textColor="@color/text_sub"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/edtProfileName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext"
                android:hint="Nhập họ và tên"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:inputType="textPersonName"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email liên hệ:"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:layout_marginTop="12dp"/>

            <EditText
                android:id="@+id/edtProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext"
                android:hint="Nhập địa chỉ email"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:inputType="textEmailAddress"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số điện thoại:"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:layout_marginTop="12dp"/>

            <EditText
                android:id="@+id/edtProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext"
                android:hint="Nhập số điện thoại"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:inputType="phone"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thể loại phim yêu thích:"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:layout_marginTop="12dp"/>

            <EditText
                android:id="@+id/edtProfileFavGenre"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext"
                android:hint="Ví dụ: Hành động, Viễn tưởng, Tình cảm"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:inputType="text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giới thiệu bản thân:"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:layout_marginTop="12dp"/>

            <EditText
                android:id="@+id/edtProfileBio"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext"
                android:hint="Mô tả sở thích xem phim của bạn..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:gravity="top|start"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="textMultiLine"/>

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="LƯU THÔNG TIN CÁ NHÂN"
                android:textColor="#121212"
                android:textStyle="bold"
                android:backgroundTint="@color/accent_gold"/>
        </LinearLayout>

        <!-- THEME SETTINGS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CÀI ĐẶT GIAO DIỆN SÁNG / TỐI"
            android:textColor="@color/accent_gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <RadioGroup
                android:id="@+id/rgThemeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbThemeDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Giao diện Tối (Dark Theme)"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_gold"
                    android:paddingVertical="8dp"/>

                <RadioButton
                    android:id="@+id/rbThemeLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Giao diện Sáng (Light Theme)"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_gold"
                    android:paddingVertical="8dp"/>

                <RadioButton
                    android:id="@+id/rbThemeSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Theo mặc định hệ thống (System Default)"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_gold"
                    android:paddingVertical="8dp"/>
            </RadioGroup>
        </LinearLayout>

        <!-- QUICK NAVIGATION SHORTCUTS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LỐI TẮC NHANH"
            android:textColor="@color/accent_gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="30dp">

            <Button
                android:id="@+id/btnNavStats"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📊 Xem Thống Kê Phim"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:backgroundTint="@color/bg_card"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnNavFavorites"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="♥ Xem Phim Yêu Thích"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:backgroundTint="@color/bg_card"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnNavWatched"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="✔ Xem Phim Đã Xem"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:backgroundTint="@color/bg_card"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
