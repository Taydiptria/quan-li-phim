<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← QUAY LẠI"
            android:textColor="#FFC107"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tvAddMovieHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÊM PHIM MỚI"
            android:textColor="#FFC107"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/edtTitle"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Tên phim (*)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#FFC107"
            android:inputType="text|textAutoCorrect"
            android:maxLines="1"/>

        <!-- GENRE DROPDOWN SELECTOR (SYNCHRONIZED WITH SEARCH / FILTER) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THỂ LOẠI PHIM (*):"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="12dp"/>

        <Spinner
            android:id="@+id/spinnerGenre"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_edittext"
            android:paddingHorizontal="12dp"
            android:popupBackground="#1E1E1E"/>

        <EditText
            android:id="@+id/edtDirector"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Đạo diễn"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#FFC107"
            android:inputType="text|textAutoCorrect"
            android:maxLines="1"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/edtYear"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Năm phát hành (*)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#FFC107"
            android:inputType="number"
            android:maxLines="1"/>

        <EditText
            android:id="@+id/edtRating"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Điểm đánh giá (0 - 10)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#FFC107"
            android:inputType="numberDecimal"
            android:maxLines="1"/>

        <!-- IMAGE SELECTION CONTAINER FROM DEVICE (UC FEATURE) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ẢNH POSTER PHIM:"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/imgPosterPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="#121212"
                android:contentDescription="Poster xem trước"/>

            <TextView
                android:id="@+id/tvPosterStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa chọn ảnh từ thiết bị"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnSelectPoster"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🖼 CHỌN ẢNH TỪ THIẾT BỊ"
                    android:textColor="#121212"
                    android:textStyle="bold"
                    android:backgroundTint="#FFC107"/>

                <Button
                    android:id="@+id/btnRemovePoster"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="XÓA ẢNH"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#E53935"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/edtDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Mô tả nội dung phim"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#FFC107"
            android:gravity="top"
            android:padding="12dp"
            android:inputType="textMultiLine|textAutoCorrect"/>

        <EditText
            android:id="@+id/edtReview"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Nhận xét cá nhân về bộ phim"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#FFC107"
            android:gravity="top"
            android:padding="12dp"
            android:inputType="textMultiLine|textAutoCorrect"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnSaveMovie"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="LƯU PHIM"
            android:textColor="#121212"
            android:textStyle="bold"
            android:backgroundTint="#FFC107"
            android:layout_marginTop="25dp"/>

    </LinearLayout>
</ScrollView>
